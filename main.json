                    "principalId": {
                      "type": "string",
                      "value": "[if(parameters('enableSystemIdentity'), reference(resourceId('Microsoft.Web/sites', parameters('name')), '2023-12-01', 'full').identity.principalId, '')]"
                    }
                  }
                }
