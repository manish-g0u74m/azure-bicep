    "webApps": {
      "type": "array",
      "metadata": {
        "description": "List of web apps: { name, planName, linuxFxVersion, ... }. Details are defined in the parameter files."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/resourceGroups",
      "apiVersion": "2024-03-01",
