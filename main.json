            }
          ],
          "outputs": {
            "webAppHostNames": {
              "type": "array",
              "copy": {
                "count": "[length(parameters('webApps'))]",
                "input": "[reference(resourceId('Microsoft.Resources/deployments', format('app-{0}', parameters('webApps')[copyIndex()].name)), '2025-04-01').outputs.defaultHostName.value]"
              }
            }
          }
        }
      },
      "dependsOn": [
